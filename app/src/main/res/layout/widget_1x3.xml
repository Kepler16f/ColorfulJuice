<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_1x3_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_device_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设备名称"
        android:textSize="12sp"
        android:textColor="#999999"
        android:ellipsize="end"
        android:maxLines="2"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_device_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_device_other"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/widget_battery_bar"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/widget_battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="75%"
            android:textSize="12sp"
            android:textColor="#666666"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
