<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_dual_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical">

    <!-- Header row: title + refresh button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="11sp"
            android:textColor="#888888" />

        <ImageView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <!-- Device 1 -->
    <LinearLayout
        android:id="@+id/widget_dual_device1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_dual_name1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设备 1"
            android:textSize="11sp"
            android:textColor="#888888"
            android:ellipsize="end"
            android:maxLines="2"
            android:layout_marginBottom="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_dual_icon1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_device_other"
                android:layout_marginEnd="4dp" />

            <ImageView
                android:id="@+id/widget_dual_bar1"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_dual_pct1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textSize="11sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Device 2 -->
    <LinearLayout
        android:id="@+id/widget_dual_device2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_dual_name2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设备 2"
            android:textSize="11sp"
            android:textColor="#888888"
            android:ellipsize="end"
            android:maxLines="2"
            android:layout_marginBottom="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_dual_icon2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_device_other"
                android:layout_marginEnd="4dp" />

            <ImageView
                android:id="@+id/widget_dual_bar2"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_dual_pct2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textSize="11sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>